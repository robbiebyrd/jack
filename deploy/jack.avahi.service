<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises Jack's OSC and OSCQuery servers over Bonjour/zeroconf (SPEC.md "OSCQuery").
     Installed to /etc/avahi/services/jack.service by install.sh. The ports are the defaults:
     if jack.env sets JACK_OSC_PORT or JACK_OSCQUERY_PORT, change them here too. -->
<service-group>
  <name replace-wildcards="yes">Jack on %h</name>
  <service>
    <type>_oscjson._tcp</type>
    <port>9001</port>
  </service>
  <service>
    <type>_osc._udp</type>
    <port>9000</port>
  </service>
</service-group>
