[Unit]
Description=Jack motor HAT application
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=10
User=jack
Group=jack
SupplementaryGroups=i2c audio
WorkingDirectory=/opt/jack
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/jack/jack.env
ExecStart=/opt/jack-venv/bin/python /opt/jack/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
